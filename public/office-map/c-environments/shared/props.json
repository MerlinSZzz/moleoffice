  "provenance": {
    "completeStools": {
      "source": "TS6woEo2Y6RR complete-stool repair accepted for the anonymous sample; formal-map support/collision still requires hJC integration review",
      "sourceSha256": "329c92eb7d52df6bb4df9ef70c3a117a625be1e9eb2af781a667410a5434fd8d",
      "orientation": "SW is the accepted complete-end-stool PNG unchanged; SE is its complete horizontal mirror, not a second generated stool",
      "anchorMeaning": "same160canvas as the associated actor;anchor80,156 refers to actorfoot,not geometric stoolcenter",
      "footprintBasis": "measured occupied bbox in the bottom6canvas rows;not a complete physical collision acceptance"
    },
    "contact": "Nonzero contact errors remain measured, not corrected by moving a table or a person. Normal long-table layers hide the stools; this is not support verification.",
    "octagonal": "Original1.0 candidate failed ground/support view and remains in cache evidence. This candidate draws the exact same PNG layers uniformly at0.62 (267x98 rounded), with a fixed ground-based seat declaration. Six bare/scarf size views have been examined; all nonzero errors remain. It supplies one SW seat, not a full ring of seats.",
    "threeFurniture": "Candidate for the next review world: fixed SW single desk, fixed three SE seats at one long desk, and a single SW end seat at the octagonal desk. PNGs alone do not select furniture; environment definitions name these IDs.",
    "lookBindingStatus": "Five looks have their own recorded hand points, complete stool orientation and real source actions on the three adopted furniture types. Single and octagonal seats face SW; long seats face SE. Existing bare/scarf declarations and all image bytes are unchanged. This is a candidate for actual world playback, not completed world acceptance.",
    "silverBookTransfer": {
      "report": "4Qm5e3Td5s39",
      "sourcePropsSha256": "31f3ad986e63bd666a0c191846ef2b88ee7bd2e3213247d3d6e402b4a1e6217a",
      "method": "Fern played twelve anonymous fixed-seat cases using the production frame, station and table-book readers. Brook viewed the three long-table transfer sheets and octagonal transfer/work sheets. The actual CForestMotion message route was not part of those clips.",
      "limits": [
        "Long-table lower body and stools remain obscured in the normal view.",
        "At actor scale 0.92, 3 long-table and 13 octagonal book pixels fall outside the full table image alpha. This measurement is not physical support verification.",
        "The reading book is held above the old desk reference point. Nonzero contact errors remain.",
        "Rear-facing sitting and a full ring of octagonal seats are not provided."
      ]
    }
  }
