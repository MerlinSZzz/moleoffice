{
  "name": "mole-office",
  "version": "0.1.0-beta.10",
  "private": true,
  "license": "MIT",
  "description": "A research and work tracker for people working with AI agents",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node tools/serve-dev.mjs",
    "dev:web": "vite",
    "serve": "node tools/serve-dev.mjs --built",
    "build": "tsc --noEmit && vite build",
    "bundle": "node scripts/bundle.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "mole-office": "node src/config/the-service-command.mjs",
    "window": "electron src/desktop/main.mjs",
    "agent": "node tools/agent-worker.mjs",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:rewrite-a-backup": "tsx scripts/rewrite-a-backup.ts",
    "db:prune-backups": "tsx scripts/prune-backups.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "MOLE_OFFICE_WHOLE_SUITE=yes vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.1",
    "fastify": "^5.11.2",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "nanoid": "^6.0.1",
    "node-pty": "1.2.0-beta.15",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/runner": "4.1.10",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "electron": "44.5.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
